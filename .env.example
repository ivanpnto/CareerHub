# Copy this file to .env (in the repository root) and replace the placeholder values.
# .env is ignored by Git and must never be committed.

# PostgreSQL container (docker/docker-compose.yml)
POSTGRES_DB=careerhub
POSTGRES_USER=careerhub
POSTGRES_PASSWORD=change-me

# Backend database connection (must match the PostgreSQL values above)
DB_URL=jdbc:postgresql://localhost:5433/careerhub
DB_USERNAME=careerhub
DB_PASSWORD=change-me

# Base64-encoded random key of at least 32 bytes.
# See docs/development-setup.md for how to generate it.
JWT_SECRET=
